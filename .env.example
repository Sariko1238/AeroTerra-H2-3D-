# ==============================================================================
# AeroTerra H2 — Environment Variables Configuration
# ==============================================================================

# 1. Neon Serverless PostgreSQL Connection String (get this from https://console.neon.tech or via `npx neonctl connection-string`)
# Example: postgres://alex:pass@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://your_user:your_password@ep-sample-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. JWT Authentication Secret (generate any long random string)
JWT_SECRET=aeroterra-h2-cyber-secret-key-2026-super-secure-token

# 3. Port for local development server (optional, default 3000)
PORT=3000
